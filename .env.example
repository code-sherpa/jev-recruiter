# All decisions use one explicitly selected provider. No fallback.
DECISION_PROVIDER=typesafe
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# For Morph, set DECISION_PROVIDER=morph and supply MORPH_API_KEY.
MORPH_API_KEY=
MORPH_MODEL=morph-systemone-v1
MORPH_API_URL=https://api.morphllm.com/v1/singleshot
RECRUITING_VIEWPORT_WIDTH=2048
RECRUITING_VIEWPORT_HEIGHT=1280
